# ==========================================
# Environment Variables (Keep Secrets Safe!)
# ==========================================
# This blocks .env files anywhere in the project
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Explicitly blocking them inside client and server just to be safe
client/.env
client/.env.local
server/.env
server/.env.local

# ==========================================
# Dependencies (Do not upload to GitHub)
# ==========================================
node_modules/
client/node_modules/
server/node_modules/

# ==========================================
# Build & Production Outputs
# ==========================================
client/build/
client/dist/
client/.next/
server/dist/
server/build/

# ==========================================
# Debugging & Logs
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# System Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/